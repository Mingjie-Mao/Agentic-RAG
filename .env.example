RAG_DATABASE_URL=postgresql+psycopg://rag:rag-local-only@127.0.0.1:55436/rag
RAG_MEMORY_URL=
# JSON map: {"tenant_id:user_id":"LLTM bearer token"}. Leave empty to disable memory.
RAG_MEMORY_TOKENS_JSON={}
RAG_AGENT_LEASE_SECONDS=300
RAG_TRIAL_MODE=false
# Comma-separated usernames. Trial users cannot upload, change ACLs, or write memories.
RAG_TRIAL_USERNAMES=
RAG_TRIAL_DAILY_LIMIT=10
RAG_SEARCH_URL=http://127.0.0.1:19200
RAG_SEARCH_INDEX=agentic-rag-s1
RAG_OLLAMA_URL=http://127.0.0.1:11436
RAG_EMBED_MODEL=bge-m3:567m
RAG_CHAT_MODEL=qwen2.5:7b-instruct
RAG_AGENT_POLICY_MODEL=qwen2.5:7b-instruct
RAG_SEMANTIC_SHADOW_ENABLED=false
# Experimental source attribution/scope contract; paired pilot showed no overall gain.
RAG_ANSWER_CONTRACT_ENABLED=false
# Source-bound extraction/conclusions: experimental, gated on fresh paired evaluation.
RAG_SOURCE_FACTS_ENABLED=false
# Experimental claims-only judgment; independently validate before enabling.
RAG_VERDICT_PROTOCOL=legacy
RAG_VERDICT_SPAN_MODE=constrained
RAG_EMBED_DIMENSION=1024
RAG_STORAGE_DIR=.runtime/files
RAG_DEMO_MODE=true
RAG_DEMO_PASSWORD=RagDemo-2026!
RAG_COOKIE_SECURE=false
RAG_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://localhost:5173"]
RAG_RETRIEVAL_MODE=hybrid
RAG_REWRITE_MODE=rule

# Optional: hosted generator for scripts/generation_ceiling.py only.
# ANTHROPIC_API_KEY=
# P0–P2 candidates: leave off until frozen paired quality/refusal/cost gates pass.
RAG_PASSAGE_WINDOW_ENABLED=false
RAG_PASSAGE_WINDOW_EXTRA=2
RAG_PASSAGE_SCAN_LIMIT=64
RAG_SOURCE_FOCUS_QUERIES=false
RAG_SOURCE_FACET_QUERIES=false
RAG_SOURCE_FACET_DOCUMENT_QUERIES=false
RAG_ARTICLE_FIRST_LANES=false
RAG_SOURCE_QUERY_PLAN=false
RAG_CLAIM_CONSISTENCY_ENABLED=false
RAG_SOURCE_FACTS_PROTOCOL=strict
RAG_SOURCE_FACTS_FALLBACK_ENABLED=false
RAG_FOCUSED_GENERATION_ENABLED=false
RAG_ADAPTIVE_ROUTING_ENABLED=true

# P0: cumulative per-task model budgets. Resuming cannot reset these limits.
RAG_AGENT_TASK_TIMEOUT_SECONDS=600
RAG_AGENT_POLICY_MAX_CALLS=12
RAG_AGENT_JUDGE_MAX_CALLS=8
RAG_AGENT_JUDGE_TOKEN_BUDGET=24000
RAG_AGENT_GENERATION_MAX_CALLS=12
# P1: shared literal comparison/condition/history contracts remain an opt-in candidate.
RAG_TASK_CONTRACT_ENABLED=true
# Bounded answer recovery and relation composition have distinct validation gates.
RAG_ANSWER_QUALITY_ENABLED=false
RAG_ANSWER_EXTRACTIVE_ENABLED=false
RAG_ANSWER_SEMANTIC_AUDIT_ENABLED=false
RAG_ANSWER_LITERAL_JUDGMENT_ENABLED=false
RAG_ANSWER_SEMANTIC_AUDIT_GATE_PATH=
RAG_ANSWER_COMPARISON_FOCUS_ENABLED=false
RAG_ANSWER_COMPOSITION_MODEL=qwen3.5:9b
RAG_ANSWER_COMPOSITION_URL=http://127.0.0.1:11437
RAG_ANSWER_COMPOSITION_REASONING=off
RAG_ANSWER_COMPOSITION_MAX_TOKENS=900
# P2/P3: independent post-completion observation, separate from the primary budget.
RAG_SEMANTIC_SLOT_SHADOW_ENABLED=false
RAG_SEMANTIC_SLOT_SHADOW_SECONDS=90
RAG_SEMANTIC_SLOT_SHADOW_SAMPLE_RATE=0.1
# Runtime control refuses activation without bound, independently reviewed P2 gates.
RAG_SEMANTIC_SLOT_CONTROL_ENABLED=false
RAG_SEMANTIC_SLOT_GATE_PATH=
RAG_SEMANTIC_SLOT_CALIBRATION_PATH=
